# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env de verdade.

# Client ID OAuth do Google (mesmo client usado no backend), pro Google Sign-In.
GOOGLE_CLIENT_ID=

# --- Conexão com o backend gRPC ---
# Opção 1: backend direto (dev local/LAN), sem TLS:
#   GRPC_HOST=192.168.x.x   (IP da máquina rodando o backend)
#   GRPC_PORT=50051
#   GRPC_USE_TLS=false
#
# Opção 2: através do túnel ngrok (docker-compose.ngrok.yml), que termina
# TLS na borda:
#   GRPC_HOST=algo-aleatorio.ngrok-free.app   (sem "https://" na frente)
#   GRPC_PORT=443
#   GRPC_USE_TLS=true
GRPC_HOST=
GRPC_PORT=50051
GRPC_USE_TLS=false
