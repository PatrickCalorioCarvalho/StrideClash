# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env de verdade.
#
# Usado pelo docker-compose.yml (serviço "backend") e pelo
# docker-compose.ngrok.yml (túnel ngrok). Não confundir com backend/.env
# (usado só quando você roda o backend fora do Docker via `go run`).

# --- Backend / Google Sign-In ---
# Client ID OAuth do Google, usado por AuthService.Login pra validar o
# id_token que o mobile manda.
GOOGLE_CLIENT_ID=

# --- Postgres ---
# Só têm efeito se você rodar o backend fora do Docker (go run). Dentro do
# docker compose, o serviço "backend" sempre fala com host "postgres"
# porta 5432 (hardcoded no docker-compose.yml) — os valores abaixo não
# fazem diferença nesse caso.
DB_USER=strideclash
DB_PASSWORD=strideclash123
DB_HOST=localhost
DB_PORT=5434
DB_NAME=strideclash
DB_SSLMODE=disable

# --- ngrok (opcional, só usado por docker-compose.ngrok.yml) ---
# Token em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# URL completa do domínio estático reservado no ngrok (ex:
# https://algo-aleatorio.ngrok-free.app) — GRÁTIS, não precisa de cartão
# (isso só é exigido pra endpoints TCP/TLS, que não usamos aqui — ver
# docker-compose.ngrok.yml). Reserve em https://dashboard.ngrok.com/domains.
# Deixe em branco pra usar um endereço aleatório (muda a cada restart do
# container ngrok).
NGROK_URL=
